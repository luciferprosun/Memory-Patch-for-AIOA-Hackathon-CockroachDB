# Copy this file to .local/external-data.env and replace only the placeholder
# mountpoint, UUID, label, and filesystem values. The local file is ignored.
AIOA_EXTERNAL_MOUNTPOINT="/absolute/mountpoint"
AIOA_EXTERNAL_DATA_ROOT="${AIOA_EXTERNAL_MOUNTPOINT}/AIOA_DATA/Memory-Patch-for-AIOA"
AIOA_EXTERNAL_DEVICE_UUID="replace-with-verified-uuid"
AIOA_EXTERNAL_DEVICE_LABEL="replace-with-verified-label"
AIOA_EXTERNAL_FILESYSTEM_TYPE="ext4"
AIOA_EXTERNAL_DEVICE_TRANSPORT="replace-with-verified-transport"
AIOA_EXTERNAL_MINIMUM_FREE_BYTES="21474836480"
AIOA_EXTERNAL_RESERVE_PERCENT="10"
AIOA_EXTERNAL_MAXIMUM_ATOMIC_WRITE_BYTES="67108864"

AIOA_CORPORA_DIR="${AIOA_EXTERNAL_DATA_ROOT}/corpora"
AIOA_EMBEDDINGS_DIR="${AIOA_EXTERNAL_DATA_ROOT}/embeddings"
AIOA_INDEXES_DIR="${AIOA_EXTERNAL_DATA_ROOT}/indexes"
AIOA_INGESTION_DIR="${AIOA_EXTERNAL_DATA_ROOT}/ingestion"
AIOA_SNAPSHOTS_DIR="${AIOA_EXTERNAL_DATA_ROOT}/snapshots"
AIOA_BACKUPS_DIR="${AIOA_EXTERNAL_DATA_ROOT}/backups"

HF_HOME="${AIOA_EXTERNAL_DATA_ROOT}/cache/huggingface"
HF_DATASETS_CACHE="${AIOA_EXTERNAL_DATA_ROOT}/cache/datasets"
TRANSFORMERS_CACHE="${AIOA_EXTERNAL_DATA_ROOT}/cache/transformers"
PIP_CACHE_DIR="${AIOA_EXTERNAL_DATA_ROOT}/cache/pip"
XDG_CACHE_HOME="${AIOA_EXTERNAL_DATA_ROOT}/cache/xdg"
TMPDIR="${AIOA_EXTERNAL_DATA_ROOT}/cache/temporary"
