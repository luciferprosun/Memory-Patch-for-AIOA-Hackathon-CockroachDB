{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aioa.example/memory-kernel/personal-memory-space/1.0.0",
  "title": "AIOA Personal Memory HAT Space 1A",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "personal_memory_space_id",
    "tenant_id",
    "user_id",
    "state",
    "display_name",
    "created_at",
    "updated_at",
    "model_binding_ids",
    "quota_policy"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "personal_memory_space_id": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "user_id": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "EMPTY",
        "CONFIGURED",
        "ACTIVE",
        "SUSPENDED",
        "ARCHIVED",
        "DELETED_PENDING",
        "DELETED"
      ]
    },
    "display_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "model_binding_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "quota_policy": {
      "$ref": "#/$defs/quotaPolicy"
    },
    "export_requested_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "deletion_requested_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "deleted_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "$defs": {
    "quotaPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maximum_total_spaces": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "maximum_active_spaces": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "maximum_archived_spaces": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "maximum_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "maximum_personal_sources": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "maximum_active_memory_patches": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "maximum_session_memory_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "maximum_ingestion_jobs": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "maximum_embedding_or_index_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    }
  }
}
