{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aioa.example/memory-kernel/correction-packet/1.0.0",
  "title": "AIOA Correction Packet 1A",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kernel_run_id",
    "draft_v1_id",
    "selected_hat_id",
    "knowledge_route",
    "action_policy",
    "evidence_status",
    "scope_dimensions",
    "knowledge_as_of",
    "claims_under_review",
    "ordered_evidence_items",
    "source_version_ids",
    "validity_or_version_scopes",
    "conflicts",
    "required_corrections",
    "prohibited_claims",
    "uncertainty",
    "citation_requirements",
    "retrieval_policy_version",
    "embedding_model_version",
    "packet_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "kernel_run_id": {
      "type": "string",
      "minLength": 1
    },
    "draft_v1_id": {
      "type": "string",
      "minLength": 1
    },
    "selected_hat_id": {
      "type": "string",
      "minLength": 1
    },
    "knowledge_route": {
      "enum": [
        "HAT_ASSIST",
        "HAT_ENFORCE"
      ]
    },
    "action_policy": {
      "enum": [
        "ALLOW",
        "DENY_ACTION",
        "REQUIRE_CONFIRMATION"
      ]
    },
    "evidence_status": {
      "enum": [
        "NOT_REQUIRED",
        "SUFFICIENT",
        "INSUFFICIENT",
        "CONFLICTING",
        "UNAVAILABLE",
        "STALE",
        "INVALID"
      ]
    },
    "scope_dimensions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scopeDimension"
      }
    },
    "knowledge_as_of": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "claims_under_review": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "ordered_evidence_items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "source_version_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "validity_or_version_scopes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scopeDimension"
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/memoryConflict"
      }
    },
    "required_corrections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/correctionRequirement"
      }
    },
    "prohibited_claims": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "uncertainty": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "citation_requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "retrieval_policy_version": {
      "type": "string",
      "minLength": 1
    },
    "embedding_model_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "packet_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "scopeDimension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value",
        "value_type",
        "comparison_mode",
        "source",
        "required"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "value": {},
        "value_type": {
          "enum": [
            "STRING",
            "INTEGER",
            "NUMBER",
            "BOOLEAN",
            "STRING_SET",
            "TIMESTAMP",
            "SEMVER",
            "JSON"
          ]
        },
        "comparison_mode": {
          "enum": [
            "EXACT",
            "IN_SET",
            "HIERARCHICAL",
            "RANGE",
            "SEMVER",
            "TIMESTAMP",
            "CUSTOM_HAT_RULE"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "draft_id",
        "statement",
        "claim_category",
        "scope_dimensions"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "draft_id": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "claim_category": {
          "type": "string",
          "minLength": 1
        },
        "scope_dimensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scopeDimension"
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "source_id",
        "source_version_id",
        "citation_reference",
        "content_hash",
        "trust_class",
        "authority_rank",
        "scope_dimensions",
        "retrieved_at",
        "valid_from",
        "valid_until",
        "metadata"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_version_id": {
          "type": "string",
          "minLength": 1
        },
        "citation_reference": {
          "type": "string",
          "minLength": 1
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "trust_class": {
          "enum": [
            "CANONICAL_SOURCE_EVIDENCE",
            "SHARED_HAT_VERIFIED_MEMORY"
          ]
        },
        "authority_rank": {
          "type": "integer",
          "minimum": 0
        },
        "scope_dimensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scopeDimension"
          }
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        },
        "valid_from": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "valid_until": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "metadata": {
          "type": "object"
        }
      }
    },
    "memoryConflict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conflict_type",
        "higher_or_primary_item_id",
        "lower_or_secondary_item_id",
        "explanation",
        "resolved_by_precedence"
      ],
      "properties": {
        "conflict_type": {
          "type": "string",
          "minLength": 1
        },
        "higher_or_primary_item_id": {
          "type": "string",
          "minLength": 1
        },
        "lower_or_secondary_item_id": {
          "type": "string"
        },
        "explanation": {
          "type": "string"
        },
        "resolved_by_precedence": {
          "type": "boolean"
        }
      }
    },
    "correctionRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_id",
        "claim_id",
        "instruction",
        "evidence_references",
        "mandatory"
      ],
      "properties": {
        "requirement_id": {
          "type": "string",
          "minLength": 1
        },
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "instruction": {
          "type": "string",
          "minLength": 1
        },
        "evidence_references": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "mandatory": {
          "type": "boolean"
        }
      }
    }
  }
}
